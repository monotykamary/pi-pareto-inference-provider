{
  "name": "pi-pareto-inference-provider",
  "version": "1.0.7",
  "description": "Pareto Inference provider extension for pi - GLM-5.3 Flash, GLM-5.3, and DeepSeek V4 Flash through Pareto's OpenAI-compatible API",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && node scripts/test-pi-compat.mjs",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "pareto",
    "paretoinference",
    "glm",
    "glm-5.3-flash",
    "deepseek",
    "ai",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-pareto-inference-provider.git"
  },
  "homepage": "https://github.com/monotykamary/pi-pareto-inference-provider#readme",
  "bugs": {
    "url": "https://github.com/monotykamary/pi-pareto-inference-provider/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^24.10.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
